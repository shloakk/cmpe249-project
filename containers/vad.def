Bootstrap: docker
From: nvidia/cuda:11.1.1-cudnn8-devel-ubuntu20.04

%files
    configs/vad-constraints.txt /opt/vad-constraints.txt

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends python3.8 python3.8-dev python3-pip git build-essential ca-certificates libgl1-mesa-glx libglib2.0-0
    python3 -m pip install pip==23.1.2 setuptools==61.2.0 wheel==0.38.4
    python3 -m pip install -c /opt/vad-constraints.txt \
        torch==1.9.1+cu111 torchvision==0.10.1+cu111 torchaudio==0.9.1 \
        -f https://download.pytorch.org/whl/torch_stable.html
    python3 -m pip install -c /opt/vad-constraints.txt numpy==1.19.5
    python3 -m pip install -c /opt/vad-constraints.txt --only-binary=mmcv-full \
        mmcv-full==1.4.0 -f https://download.openmmlab.com/mmcv/dist/cu111/torch1.9.0/index.html
    python3 -m pip install -c /opt/vad-constraints.txt \
        mmdet==2.14.0 mmsegmentation==0.14.1 timm==0.6.12 nuscenes-devkit==1.1.9
    export CUDA_HOME=/usr/local/cuda
    export FORCE_CUDA=1
    export TORCH_CUDA_ARCH_LIST=8.0
    export MAX_JOBS=2
    python3 -m pip install --no-build-isolation -c /opt/vad-constraints.txt \
        git+https://github.com/open-mmlab/mmdetection3d.git@f1107977dfd26155fc1f83779ee6535d2468f449
    python3 -m pip check
    python3 -m pip freeze --all > /opt/vad-pip-freeze.txt

%environment
    export PYTHONNOUSERSITE=1
    export PYTHONDONTWRITEBYTECODE=1

%labels
    VADCommit 1688c4b1c3a9e2e7873ca9700ff8058170c0e3c8
    MMDetection3DCommit f1107977dfd26155fc1f83779ee6535d2468f449
    Description "Candidate VAD runtime; validate imports and CUDA ops before evaluation"
